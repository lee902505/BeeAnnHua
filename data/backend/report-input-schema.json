{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellar-diary.local/schema/report-input-v1.json",
  "title": "Stellar Diary Report Input",
  "type": "object",
  "required": ["schema", "schemaVersion", "reportType", "meta", "method", "reportRequest"],
  "properties": {
    "schema": {"const": "stellar-diary.report-input"},
    "schemaVersion": {"const": "1.0.0"},
    "reportType": {"enum": ["natal", "synastry"]},
    "meta": {
      "type": "object",
      "required": ["app", "appVersion", "protocolVersion", "locale", "generatedAt", "fingerprint"],
      "properties": {
        "app": {"const": "stellar-diary"},
        "appVersion": {"type": "string"},
        "protocolVersion": {"type": "string"},
        "locale": {"enum": ["zh-CN", "zh-TW", "en"]},
        "generatedAt": {"type": "string"},
        "fingerprint": {"type": "string", "minLength": 8}
      },
      "additionalProperties": true
    },
    "method": {
      "type": "object",
      "required": ["zodiac", "deterministicChart", "astronomyEngine", "interpretationMode"],
      "properties": {
        "zodiac": {"const": "tropical"},
        "deterministicChart": {"const": true},
        "astronomyEngine": {"type": "string"},
        "interpretationMode": {"const": "symbolic-traditional"},
        "disclaimer": {"type": "string"}
      },
      "additionalProperties": true
    },
    "subject": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "gender": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "birth": {"$ref": "#/$defs/birth"},
    "chart": {"$ref": "#/$defs/chart"},
    "relationship": {
      "type": "object",
      "properties": {"type": {"type": "string"}},
      "additionalProperties": true
    },
    "people": {
      "type": "object",
      "properties": {
        "A": {"$ref": "#/$defs/person"},
        "B": {"$ref": "#/$defs/person"}
      },
      "required": ["A", "B"],
      "additionalProperties": false
    },
    "crossChart": {
      "type": "object",
      "properties": {
        "aspects": {"type": "array", "items": {"$ref": "#/$defs/crossAspect"}},
        "summary": {"type": "object"}
      },
      "additionalProperties": true
    },
    "compatibility": {"type": ["object", "null"]},
    "reportRequest": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "location": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "name": {"type": ["object", "string", "null"]},
        "country": {"type": ["object", "string", "null"]},
        "admin1": {"type": ["string", "null"]},
        "admin2": {"type": ["string", "null"]},
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "timezone": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "birth": {
      "type": "object",
      "properties": {
        "calendarMode": {"enum": ["solar", "lunar"]},
        "originalLabel": {"type": ["string", "null"]},
        "solarDate": {"type": ["string", "null"]},
        "localTime": {"type": ["string", "null"]},
        "unknownTime": {"type": "boolean"},
        "location": {"$ref": "#/$defs/location"}
      },
      "required": ["calendarMode", "solarDate", "unknownTime", "location"],
      "additionalProperties": true
    },
    "sign": {
      "type": "object",
      "properties": {
        "index": {"type": ["integer", "null"], "minimum": 0, "maximum": 11},
        "key": {"type": ["string", "null"]}
      },
      "required": ["index", "key"],
      "additionalProperties": false
    },
    "position": {
      "type": ["object", "null"],
      "properties": {
        "body": {"type": ["string", "null"]},
        "sign": {"$ref": "#/$defs/sign"},
        "degree": {"type": ["number", "null"]},
        "longitude": {"type": ["number", "null"]},
        "house": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "retrograde": {"type": "boolean"},
        "speedDegPerDay": {"type": ["number", "null"]},
        "signUncertain": {"type": "boolean"},
        "possibleSignIndexes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 11}}
      },
      "additionalProperties": true
    },
    "aspect": {
      "type": "object",
      "required": ["type", "body1", "body2", "orb"],
      "properties": {
        "type": {"enum": ["conjunction", "sextile", "square", "trine", "opposition"]},
        "body1": {"type": ["string", "null"]},
        "body2": {"type": ["string", "null"]},
        "angle": {"type": ["number", "null"]},
        "separation": {"type": ["number", "null"]},
        "orb": {"type": ["number", "null"]},
        "limit": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "crossAspect": {
      "type": "object",
      "required": ["type", "bodyA", "bodyB", "orb"],
      "properties": {
        "type": {"enum": ["conjunction", "sextile", "square", "trine", "opposition"]},
        "bodyA": {"type": "string"},
        "bodyB": {"type": "string"},
        "angle": {"type": ["number", "null"]},
        "separation": {"type": ["number", "null"]},
        "orb": {"type": ["number", "null"]},
        "limit": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "chart": {
      "type": "object",
      "required": ["mode", "planets", "angles", "aspects", "distributions", "synthesis"],
      "properties": {
        "mode": {"enum": ["exact", "unknown-time"]},
        "utc": {"type": "string"},
        "planets": {"type": "object", "additionalProperties": {"$ref": "#/$defs/position"}},
        "angles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/position"}},
        "houses": {"type": ["object", "null"]},
        "aspects": {"type": "array", "items": {"$ref": "#/$defs/aspect"}},
        "uncertainty": {"type": "object"},
        "distributions": {"type": "object"},
        "synthesis": {"type": "object"}
      },
      "additionalProperties": true
    },
    "person": {
      "type": "object",
      "required": ["name", "birth", "chart"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "birth": {"$ref": "#/$defs/birth"},
        "chart": {"$ref": "#/$defs/chart"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reportType": {"const": "natal"}}},
      "then": {"required": ["birth", "chart"]}
    },
    {
      "if": {"properties": {"reportType": {"const": "synastry"}}},
      "then": {"required": ["relationship", "people", "crossChart", "compatibility"]}
    }
  ],
  "additionalProperties": true
}
