  "schema": "ro_web_character_manifest",
  "schema_version": "2.0",
  "exporter": "RO_WEB V0.9.80Z Novice Family Character Assets",
  "default_job": "novice",
  "default_gender": "male",
  "default_character": "novice_male",
  "asset_root": "assets/characters",
  "rules": {
    "characterKey": "{job}_{gender}",
    "runtimeResolve": "currentJob + gender + weaponType",
    "idleUsage": "town/profile use assets/characters/{job}/{gender}/idle.png",
    "atlasUsage": "field/world use motion json paths in each gender folder",
    "noLegacyFallback": "old swordman/knight static image must not be used as fallback",
    "sharedJobAsset": "expanded_super_novice shares super_novice files; no duplicate PNG copies."
  },
